---
const deployDate = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: 'UTC',
  timeZoneName: 'short',
}).format(new Date());
---

<footer>
  <p>
    &copy; 2005-{new Date().getFullYear()} Colin Mackay.
    Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.
    Template by <a href="https://www.twitter.com/Charca" target="_blank" rel="noopener">Maxi Ferreira</a>.
    Site last deployed on {deployDate}.
  </p>
  <p>
    <span>
      <a
        href="https://dashboard.simpleanalytics.com/?utm_source=&utm_content=badge&affiliate=rukep"
        referrerpolicy="origin"
        target="_blank">
        <picture>
          <source
            srcset="https://simpleanalyticsbadges.com/?mode=auto"
            media="(prefers-color-scheme: dark)"
          />
          <img
            src="https://simpleanalyticsbadges.com/?mode=light"
            loading="lazy"
            referrerpolicy="no-referrer"
            crossorigin="anonymous"
          />
        </picture>
      </a>
    </span>
  </p>
</footer>

<style>
  footer p {
    color: var(--text-secondary);
    font-size: .8em;
    margin: 1em auto;
    max-width: 1400px;
    padding: 1em 2em;
    text-align: center;
    width: 100%;
  }
</style>
