---
const { tags = [] } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-list">
    {tags.map((tag) => (
      <li>
        <a href={`/tag/${tag.slug}`}>{tag.name}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6em;
    list-style: none;
    margin: 1em 0 0 0;
    padding: 0;
  }

  .tag-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-family-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-secondary);
    border: 1px solid var(--primary-color);
    border-radius: 99em;
    padding: 0.3em 0.9em;
    text-decoration: none;
    transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
  }

  .tag-list a::before {
    content: '';
    display: block;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    background-color: currentColor;
    mask: url('/assets/tag.svg') no-repeat center / contain;
    -webkit-mask: url('/assets/tag.svg') no-repeat center / contain;
  }

  .tag-list a:hover {
    background-color: var(--primary-color);
    color: #fff;
  }
</style>
