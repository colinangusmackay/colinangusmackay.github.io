---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts')
const tagMap = new Map();

for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!tagMap.has(tag.slug)) {
      tagMap.set(tag.slug, { name: tag.name, count: 0 });
    }
    tagMap.get(tag.slug).count++;
  }
}

const tags = Array.from(tagMap.entries())
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));

const groupMap = new Map<string, typeof tags>();

for (const tag of tags) {
  const firstChar = tag.name.charAt(0).toUpperCase();
  const letter = /[A-Z]/.test(firstChar) ? firstChar : '#';
  if (!groupMap.has(letter)) {
    groupMap.set(letter, []);
  }
  groupMap.get(letter)!.push(tag);
}

const groups = Array.from(groupMap.entries())
  .map(([letter, tags]) => ({ letter, tags }))
  .sort((a, b) => a.letter.localeCompare(b.letter));

const title = 'Tags';
const description = 'Browse all blog post tags.';
const permalink = `${Astro.site.href}tag`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <div class="container">
    <h1>Tags</h1>
    {groups.map((group) => (
      <section class="tag-group">
        <h2 class="tag-group-letter">{group.letter}</h2>
        <ul class="tag-index">
          {group.tags.map((tag) => (
            <li>
              <a href={`/tag/${tag.slug}`}>{tag.name}</a> <span class="tag-count">({tag.count})</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .tag-group {
    margin: 1.5em 0;
  }

  .tag-group-letter {
    margin: 0 0 0.4em;
    padding-bottom: 0.1em;
    border-bottom: 1px solid var(--text-secondary);
    font-family: var(--font-family-sans);
    text-transform: uppercase;
  }

  .tag-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: block;
    flex-wrap: wrap;
    gap: 0em 0.5em;
  }

  .tag-index li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .tag-index li::before {
    content: '';
    display: block;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    background-color: var(--primary-color);
    mask: url('/assets/tag.svg') no-repeat center / contain;
    -webkit-mask: url('/assets/tag.svg') no-repeat center / contain;
  }

  .tag-index a {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .tag-count {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
  }
</style>
