---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts')
const tagMap = new Map();

for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!tagMap.has(tag.slug)) {
      tagMap.set(tag.slug, { name: tag.name, count: 0 });
    }
    tagMap.get(tag.slug).count++;
  }
}

const tags = Array.from(tagMap.entries())
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));

const groupMap = new Map<string, typeof tags>();

for (const tag of tags) {
  const firstChar = tag.name.charAt(0).toUpperCase();
  const letter = /[A-Z]/.test(firstChar) ? firstChar : '#';
  if (!groupMap.has(letter)) {
    groupMap.set(letter, []);
  }
  groupMap.get(letter)!.push(tag);
}

const groups = Array.from(groupMap.entries())
  .map(([letter, tags]) => ({ letter, tags }))
  .sort((a, b) => a.letter.localeCompare(b.letter));

const title = 'Tags';
const description = 'Browse all blog post tags.';
const permalink = `${Astro.site.href}tag`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <div class="container">
    <h1>Tags</h1>
    <div class="tag-filter">
      <label class="visually-hidden" for="tag-filter-input">Filter tags</label>
      <input
        type="search"
        id="tag-filter-input"
        class="tag-filter-input"
        placeholder="Filter tags&hellip;"
        autocomplete="off"
        aria-describedby="tag-filter-status"
      />
    </div>
    <p id="tag-filter-status" class="tag-filter-status visually-hidden" role="status" aria-live="polite"></p>
    <p class="tag-filter-empty" hidden>No tags match your filter.</p>
    {groups.map((group) => (
      <section class="tag-group" data-tag-group>
        <h2 class="tag-group-letter">{group.letter}</h2>
        <ul class="tag-index">
          {group.tags.map((tag) => (
            <li data-tag-name={tag.name.toLowerCase()}>
              <a href={`/tag/${tag.slug}`}>{tag.name}</a> <span class="tag-count">({tag.count})</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <script>
    const input = document.getElementById('tag-filter-input') as HTMLInputElement | null;
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-tag-group]'));
    const emptyMessage = document.querySelector<HTMLElement>('.tag-filter-empty');
    const status = document.getElementById('tag-filter-status');

    if (input) {
      const applyFilter = () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;

        for (const group of groups) {
          let groupHasMatch = false;

          for (const item of group.querySelectorAll<HTMLElement>('li[data-tag-name]')) {
            const name = item.dataset.tagName ?? '';
            const match = query === '' || name.includes(query);
            item.hidden = !match;
            if (match) {
              groupHasMatch = true;
              visibleCount++;
            }
          }

          group.hidden = !groupHasMatch;
        }

        if (emptyMessage) {
          emptyMessage.hidden = visibleCount !== 0;
        }

        if (status) {
          status.textContent = query === ''
            ? ''
            : `${visibleCount} tag${visibleCount === 1 ? '' : 's'} match "${input.value.trim()}".`;
        }
      };

      input.addEventListener('input', applyFilter);
      applyFilter();
    }
  </script>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tag-filter {
    margin: 1em 0 0.5em;
  }

  .tag-filter-input {
    width: 100%;
    max-width: 24em;
    padding: 0.5em 0.75em;
    font-family: var(--font-family-sans);
    font-size: 1em;
    color: var(--text-main);
    background-color: var(--background-body);
    border: 1px solid var(--text-secondary);
    border-radius: 4px;
  }

  .tag-filter-input:focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 1px;
  }

  .tag-filter-empty {
    font-family: var(--font-family-sans);
    color: var(--text-secondary);
  }

  .tag-group {
    margin: 1.5em 0;
  }

  .tag-group-letter {
    margin: 0 0 0.4em;
    padding-bottom: 0.1em;
    border-bottom: 1px solid var(--text-secondary);
    font-family: var(--font-family-sans);
    text-transform: uppercase;
  }

  .tag-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: block;
    flex-wrap: wrap;
    gap: 0em 0.5em;
  }

  .tag-index li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .tag-group[hidden],
  .tag-index li[hidden] {
    display: none;
  }

  .tag-index li::before {
    content: '';
    display: block;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    background-color: var(--primary-color);
    mask: url('/assets/tag.svg') no-repeat center / contain;
    -webkit-mask: url('/assets/tag.svg') no-repeat center / contain;
  }

  .tag-index a {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .tag-count {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
  }
</style>
